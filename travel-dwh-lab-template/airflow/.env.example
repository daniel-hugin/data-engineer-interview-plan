# Copia a airflow/.env y rellena. NUNCA subas .env al repo.
# Genera secretos con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Fernet key con:       python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

AIRFLOW_UID=50000
POSTGRES_PASSWORD=cambia-esto
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambia-esto

# --- Snowflake ---
# Identificador de cuenta: <org>-<cuenta> (Snowsight > Admin > Accounts)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SVC_AIRFLOW
SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/keys/svc_airflow.p8

# Conexión que usa el DAG de ingesta (rol LOADER)
AIRFLOW_CONN_SNOWFLAKE_DEFAULT='{"conn_type": "snowflake", "login": "SVC_AIRFLOW", "extra": {"account": "<org>-<cuenta>", "warehouse": "LOADING_WH", "database": "RAW", "role": "LOADER", "private_key_file": "/opt/airflow/keys/svc_airflow.p8"}}'
