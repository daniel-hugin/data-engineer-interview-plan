{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/keys/**)",
      "Read(**/.env)",
      "Read(**/*.p8)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.snowflake/**)",
      "Bash(cat *keys/*)",
      "Bash(cat *.env)",
      "Bash(cat *.p8*)",
      "Bash(cat *.pem*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(dbt * --target prod*)",
      "Bash(dbt * -t prod*)",
      "Bash(git push * main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(gh pr merge*)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(rm -rf *)",
      "Bash(snow sql*)",
      "Bash(snowsql*)"
    ]
  }
}
